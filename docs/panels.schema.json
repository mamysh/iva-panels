{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "iva-panels/v1"
    },
    "plugin": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
    },
    "pluginVersion": {
      "type": "string",
      "maxLength": 48,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]*$"
    },
    "entry": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,23}$"
    },
    "pages": {
      "minItems": 1,
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,23}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "body": {
            "type": "string",
            "maxLength": 1500
          },
          "rows": {
            "maxItems": 5,
            "type": "array",
            "items": {
              "minItems": 1,
              "maxItems": 2,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 48
                  },
                  "target": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,23}$"
                  }
                },
                "required": ["label", "target"],
                "additionalProperties": false
              }
            }
          }
        },
        "required": ["id", "title", "body", "rows"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema", "plugin", "pluginVersion", "entry", "pages"],
  "additionalProperties": false
}
